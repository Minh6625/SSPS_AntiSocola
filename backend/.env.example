# ========================
# BACKEND ENVIRONMENT VARIABLES
# ========================
# Copy file này thành .env rồi điền các giá trị thực tế

# DATABASE CONFIGURATION (SQL Server)
DB_HOST=...
DB_PORT=...
DB_NAME=...
DB_USERNAME=...
DB_PASSWORD=...

# SERVER CONFIGURATION
SERVER_PORT=8080
APP_NAME=layered-architecture-backend

# ========================
# JWT TOKENS CONFIGURATION
# ========================
JWT_SECRET=...
JWT_ACCESS_EXPIRATION=...
JWT_REFRESH_EXPIRATION=...

# ========================
# EMAIL CONFIGURATION (OTP & NOTIFICATIONS)
# ========================
# Google SMTP Server
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Gmail Account (bật 2FA trước)
# Hướng dẫn: https://support.google.com/accounts/answer/185833
MAIL_USERNAME=your-email@gmail.com

# App Password (16 ký tự - lấy từ Google Account)
# Tạo tại: https://myaccount.google.com/apppasswords
# Chọn: App = Mail, Device = Windows Computer
MAIL_PASSWORD=your-16-char-app-password

# Email Sender Info
MAIL_FROM_ADDRESS=no-reply@ssps.hcmiu.edu.vn
MAIL_FROM_NAME=HCMIU SSPS System

# ========================
# OTP CONFIGURATION
# ========================
# OTP length (số chữ số)
OTP_LENGTH=6

# OTP hết hạn sau (phút)
OTP_EXPIRATION_MINUTES=10

# Max failed attempts (vượt quá sẽ lock account)
OTP_MAX_ATTEMPTS=5

# Cooldown giữa các lần resend OTP (giây)
OTP_RESEND_COOLDOWN_SECONDS=60

# ========================
# LOGGING
# ========================
LOG_LEVEL=INFO
